{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeGar Architecture",
  "description": "Declarative application architecture consumed by the CodeGar compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "app"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "app": {
      "$ref": "#/$defs/app"
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },

    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },

    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "enum",
            "reference"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {},
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "entity": {
          "$ref": "#/$defs/identifier"
        }
      }
    },

    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "route",
        "type",
        "entity"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "list",
            "create",
            "edit",
            "detail"
          ]
        },
        "entity": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
